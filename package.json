{
  "name": "h2cidr",
  "version": "0.1.0",
  "description": "Map hostname/domain to ASN CIDR ranges via iptoasn",
  "type": "module",
  "bin": {
    "h2cidr": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:online": "vitest run --config vitest.online.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "knip": "knip",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "execa": "^9.5.0",
    "knip": "^5.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
